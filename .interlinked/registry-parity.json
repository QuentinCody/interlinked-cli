{
	"_comment": "Per-project registry-parity config. Pairs of files whose IDs must stay in sync; entries in `left_only_allowed` / `right_only_allowed` are documented exceptions. Detector lives in src/harness/registry-parity.ts and runs on every `interlinked verify`.",
	"pairs": [
		{
			"name": "suggestion-checks",
			"left": {
				"file": "src/harness/server/suggestion-checks.ts",
				"key_re": "check:\\s*\"([a-z0-9-]+)\""
			},
			"right": {
				"file": "src/commands/verify/suggestions.ts",
				"key_re": "check:\\s*\"([a-z0-9-]+)\""
			},
			"left_only_allowed": [
				"bare-catch-block",
				"boolean-trap",
				"c-strcmp-boolean-misuse",
				"c-unchecked-malloc",
				"catch-and-ignore",
				"catch-return-null",
				"commented-out-code",
				"deletion-comment",
				"deprecation-notice",
				"empty-function-body",
				"error-string-comparison",
				"flag-arguments",
				"function-arity",
				"god-file",
				"inconsistent-error-strategy",
				"magic-numbers",
				"narrative-naming",
				"negated-condition-with-else",
				"nested-ternary",
				"not-implemented-stub",
				"orphaned-test-stub",
				"test-description-quality",
				"throw-as-control-flow",
				"untyped-catch"
			],
			"right_only_allowed": []
		},
		{
			"name": "advisory-check-ids",
			"left": {
				"file": "src/harness/advisory-check-ids.ts",
				"key_re": "\\n\\t\"([a-z0-9_]+)\","
			},
			"right": {
				"file": "src/commands/verify/advisory.ts",
				"key_re": "\\n\\t\"([a-z0-9_]+)\","
			},
			"left_only_allowed": [
				"swift_unhandled_task_error",
				"swift_global_var_no_isolation",
				"swift_self_in_escaping_closure",
				"swift_notification_observer_no_removal",
				"swift_timer_no_invalidate",
				"swift_combine_no_store",
				"swift_try_question_discarded",
				"swift_fatalerror_in_guard",
				"swift_print_in_view_body",
				"swift_abbreviations",
				"mock_only_test",
				"happy_path_only_test",
				"introverted_test",
				"test_legitimacy",
				"procfs_probe_in_test",
				"duplicate_throw_message_assertion",
				"fallback_only_assertion",
				"spy_call_unpinned_args",
				"wildcard_in_observable",
				"fixed_port_in_test",
				"in_tree_temp_fixture",
				"catch_without_assertion_guard",
				"duplicate_expected_literal_pos_neg",
				"vacuous_loop_assertion",
				"mock_return_echo",
				"duplicate_test_body",
				"spy_without_restore",
				"export_existence_smoke_test",
				"commented_out_assertion"
			],
			"right_only_allowed": []
		}
	]
}
