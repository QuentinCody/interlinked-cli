				"post_image_set_bytes": {
					"const": 52428800
				},
				"schema_version": {
					"const": 1
				},
				"single_entry_bytes": {
					"const": 10485760
				},
				"stdio_head_bytes": {
					"const": 65536
				},
				"sync_eligible_entries": {
					"const": 200
				},
				"sync_eligible_http_requests": {
					"const": 80
