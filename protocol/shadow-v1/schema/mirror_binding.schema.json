{
	"$id": "shadow-v1/mirror_binding.schema.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"additionalProperties": false,
	"description": "Shadow protocol v1 persisted record \"mirror_binding\", generated from types-transport.ts.",
	"properties": {
		"last_known": {
			"additionalProperties": false,
			"properties": {
				"base_local_head": {
					"pattern": "^[0-9a-f]{40}$",
					"type": "string",
					"x-brand": {
						"__brand": "gitsha"
					}
				},
				"base_ref": {
					"pattern": "^[0-9a-f]{40}$",
					"type": "string",
					"x-brand": {
						"__brand": "gitsha"
					}
				},
				"key": {
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "synthetic_full_tree"
						},
						"repository_id": {
							"pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
							"type": "string",
							"x-brand": {
								"__brand": "opaque-id"
							}
						},
						"session_id": {
							"pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
							"type": "string",
							"x-brand": {
								"__brand": "opaque-id"
							}
						}
					},
					"required": [
						"kind",
						"repository_id",
						"session_id"
					],
					"type": "object"
				},
				"version": {
					"minimum": 0,
					"type": "integer"
				}
			},
			"required": [
				"base_local_head",
				"base_ref",
				"key",
				"version"
			],
			"type": "object"
		},
		"mirror_key": {
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "synthetic_full_tree"
				},
				"repository_id": {
					"pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
					"type": "string",
					"x-brand": {
						"__brand": "opaque-id"
					}
				},
				"session_id": {
					"pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
					"type": "string",
					"x-brand": {
						"__brand": "opaque-id"
					}
				}
			},
			"required": [
				"kind",
				"repository_id",
				"session_id"
			],
			"type": "object"
		},
		"schema_version": {
			"const": 1
		}
	},
	"required": [
		"last_known",
		"mirror_key",
		"schema_version"
	],
	"title": "MirrorBindingV1",
	"type": "object",
	"x-shadow-contract": "structural-shape",
	"x-shadow-contract-meaning": "Shape metadata derived from the TypeScript declarations only (keys, required sets, literals, brand patterns, integers). NOT the validator: byte/array bounds, calendar validity, path rules, set/sort semantics and cross-field rules live in the parsers. A second implementation must port field-checks.ts and the parse-*.ts modules and execute protocol/shadow-v1/fixtures/malformed-corpus.json; schema validity is necessary, not sufficient.",
	"x-shadow-record": {
		"id": "mirror_binding",
		"kind": "persisted",
		"module": "types-transport.ts",
		"type": "MirrorBindingV1"
	}
}
