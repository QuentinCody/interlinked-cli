#!/usr/bin/env bash
# ============================================================================
# Pre-push gate — block any push that would land red CI on main
# ============================================================================
#
# Runs the same checks CI runs (typecheck + test), in the same order, so any
# failure shows up here BEFORE it shows up as a red main commit. CI exists
# to catch what local checks miss; this hook exists so CI is the safety net,
# not the primary signal.
#
# Activation: `npm run setup-hooks` (or `npm install` via the prepare script)
# points `core.hooksPath` at scripts/git-hooks/, so every contributor gets
# the gate without depending on husky/lefthook.
#
# Bypass: `git push --no-verify` (use only when you know what you're doing —
# every bypass risks the very class of failure this hook exists to prevent).

set -uo pipefail

# Each protected revision is verified in its own disposable export. A report
# generated elsewhere, even after the commit, cannot establish source identity.
remote="$1"
url="$2"
source_root="$(pwd -P)"
hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
protected_branch_re='^(main|master)$'
push_shas=()
push_paths=()
push_docs=()
push_packages=()
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_ref" ] && continue
    [ "$local_sha" = "$zero" ] && continue
    branch_short="${remote_ref##refs/heads/}"
    [[ "$branch_short" =~ $protected_branch_re ]] || continue
    docs_only=1
    pkg_touched=0
    if [ "$remote_sha" = "$zero" ] || ! diff_files="$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null)"; then
        docs_only=0
        pkg_touched=1
        diff_files="$(git ls-tree -r --name-only "$local_sha")" || exit 1
    else
        if [ -z "$diff_files" ] || printf '%s\n' "$diff_files" | grep -vE '\.md$' >/dev/null; then docs_only=0; fi
        if printf '%s\n' "$diff_files" | grep -E '^(package(-lock)?\.json|\.npmignore|tsup\.config|src/index\.ts|src/hook-entry\.ts|src/harness/server\.ts|src/lib/demo-runtime/|scripts/(fix-dist-dts|copy-runtime-assets|ci-packaging|ci-local|smoke-tarball-install|smoke-onboarding)\.)' >/dev/null; then pkg_touched=1; fi
    fi
    push_shas+=("$local_sha")
    push_paths+=("$diff_files")
    push_docs+=("$docs_only")
    push_packages+=("$pkg_touched")
done

export_dir=""
cleanup_export() {
    if [ -n "$export_dir" ]; then
        git -C "$source_root" worktree remove --force "$export_dir/tree" >/dev/null 2>&1
        rm -rf "$export_dir" >/dev/null 2>&1
        export_dir=""
    fi
}
trap cleanup_export EXIT

run_gate() {
    local push_sha="$1" changed_paths="$2" docs_only="$3" pkg_touched="$4"
    local gate_dir cov_files cov_report cov_cli cov_json
    export_dir="$(mktemp -d "${TMPDIR:-/tmp}/prepush-revision-XXXXXX")" || return 1
    if ! git worktree add --detach --quiet "$export_dir/tree" "$push_sha" \
        || [ -e "$export_dir/tree/node_modules" ] || [ -L "$export_dir/tree/node_modules" ] \
        || ! ln -s "$source_root/node_modules" "$export_dir/tree/node_modules"; then
        echo "[pre-push] Cannot export $push_sha for verification; push blocked."
        return 1
    fi
    gate_dir="$(cd "$export_dir/tree" && pwd -P)"
    echo "[pre-push] Gating exact pushed revision $push_sha in $gate_dir — working tree untouched."
    if [ "$docs_only" -eq 1 ]; then
        (cd "$gate_dir" && npm run docs:check) || return 1
        echo "[pre-push] ✓ doc markers OK for $push_sha"
        cleanup_export
        return 0
    fi
    (cd "$gate_dir" && npm run typecheck:stable) || {
        echo "[pre-push] typecheck:stable failed for $push_sha."
        return 1
    }
    (cd "$gate_dir" && npm run docs:check) || return 1
    if (cd "$gate_dir" && node -e 'process.exit((require("./package.json").scripts||{}).build?0:1)'); then
        (cd "$gate_dir" && npm run build) || return 1
    fi
    cov_files="$(printf '%s\n' "$changed_paths" | grep -E '^src/.*\.(ts|tsx|js|mjs|cjs)$' | LC_ALL=C sort -u | paste -sd, - || true)"
    if [ -z "$cov_files" ]; then
        (cd "$gate_dir" && CI=1 npm test) || {
            echo "[pre-push] tests failed for $push_sha."
            return 1
        }
        echo "[pre-push] coverage check SKIPPED: no src/ code files in the push range."
    else
        # Run tests once, with coverage, against this exact revision. Reusing a
        # working-tree report by mtime can certify completely different code.
        (cd "$gate_dir" && CI=1 npm test -- --coverage --testTimeout=120000 --coverage.reporter=json-summary) || {
            echo "[pre-push] tests failed for $push_sha."
            return 1
        }
        if ! git -C "$gate_dir" diff --quiet "$push_sha" --; then
            echo "[pre-push] Tests changed committed inputs; coverage is unmeasured."
            return 1
        fi
        cov_report="$gate_dir/coverage/coverage-summary.json"
        mkdir -p "$gate_dir/.interlinked" || return 1
        if [ -f "$source_root/.interlinked/coverage-baseline.json" ]; then
            cp "$source_root/.interlinked/coverage-baseline.json" "$gate_dir/.interlinked/coverage-baseline.json" || return 1
        else
            printf '%s\n' '{"version":1,"updated_at":"1970-01-01T00:00:00.000Z","files":{}}' > "$gate_dir/.interlinked/coverage-baseline.json" || return 1
        fi
        node "$hook_dir/../pre-push-coverage.mjs" "$gate_dir" "$cov_report" "$gate_dir/.interlinked/coverage-baseline.json" "$cov_files" || return 1
        if [ ! -f "$gate_dir/dist/index.js" ]; then
            echo "[pre-push] Pushed revision has no built coverage checker; verification unavailable."
            return 1
        fi
        cov_cli=(node "$gate_dir/dist/index.js")
        echo "[pre-push] Running strict coverage ratchet for $push_sha..."
        cov_json="$(cd "$gate_dir" && "${cov_cli[@]}" coverage check --strict --report "$cov_report" --changed-files "$cov_files" --json)" || { printf '%s\n' "$cov_json"; return 1; }
        if ! printf '%s\n' "$cov_json" | node -e '
try {
    const result = JSON.parse(require("node:fs").readFileSync(0, "utf8"));
    if (result.partialReport?.partial !== false || !Array.isArray(result.findings)
        || !Number.isSafeInteger(result.stats?.files_checked) || result.stats.files_checked < 0) {
        throw new Error("Coverage is partial or unmeasured.");
    }
    if (result.findings.length > 0) throw new Error("Coverage findings remain in the push scope.");
    if (result.stats.files_checked === 0) console.log("[pre-push] No runtime coverage targets in the push scope; no coverage pass certified.");
    else console.log(`[pre-push] ✓ no coverage regressions in ${result.stats.files_checked} measured file(s)`);
} catch (error) { console.error(`[pre-push] ${error.message}`); process.exitCode = 1; }
'; then return 1; fi
    fi
    if [ "$pkg_touched" -eq 1 ]; then
        (cd "$gate_dir" && bash scripts/ci-packaging.sh) || return 1
    fi
    echo "[pre-push] ✓ typecheck + tests pass for $push_sha"
    cleanup_export
}

# A SHA pushed to both main and master needs one run over the union of its
# comparison ranges. Different revisions never share a test or coverage report.
seen=" "
for ((index=0; index<${#push_shas[@]}; index++)); do
    sha="${push_shas[$index]}"
    [[ "$seen" == *" $sha "* ]] && continue
    seen="$seen$sha "
    paths=""
    docs=1
    packages=0
    for ((other=0; other<${#push_shas[@]}; other++)); do
        [ "${push_shas[$other]}" = "$sha" ] || continue
        paths="${paths}${paths:+$'\n'}${push_paths[$other]}"
        [ "${push_docs[$other]}" -eq 0 ] && docs=0
        [ "${push_packages[$other]}" -eq 1 ] && packages=1
    done
    if ! run_gate "$sha" "$paths" "$docs" "$packages"; then
        echo "❌ pre-push: verification failed or unavailable for $sha. Push blocked."
        exit 1
    fi
done
exit 0
