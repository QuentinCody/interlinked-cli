/**
 * wrangler config for the interlinked-cli landing page.
 *
 * Deploy:    npx wrangler deploy
 * Local:     npx wrangler dev
 *
 * API and health routes run the Worker first. Other paths use Workers Static
 * Assets, falling through to the Worker when no static file matches.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interlinked-landing",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  // Waitlist email store. Rows are `wl:<email>` JSON; export via
  // GET /api/waitlist/export with the ADMIN_TOKEN secret
  // (wrangler secret put ADMIN_TOKEN).
  "kv_namespaces": [
    {
      "binding": "WAITLIST_KV",
      "id": "9c9a776ebb0a4438a820bff6594cd6c2"
    }
  ],
  "routes": [
    {
      "pattern": "interlinked.quentincody.dev",
      "custom_domain": true
    }
  ],
  // Keep the *.workers.dev URL alive alongside the custom domain. It's on
  // a separate parent zone from quentincody.dev so it sidesteps any
  // zone-level WAF / Bot Fight Mode / cached-error-state interactions
  // that might affect the custom hostname for specific visitors. Free
  // operational hedge.
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
