{
	"$id": "shadow-v1/execution_manifest.schema.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"additionalProperties": false,
	"description": "Shadow protocol v1 wire record \"execution_manifest\", generated from types-core.ts.",
	"properties": {
		"mirror": {
			"additionalProperties": false,
			"properties": {
				"key": {
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "synthetic_full_tree"
						},
						"repository_id": {
							"pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
							"type": "string",
							"x-brand": {
								"__brand": "opaque-id"
							}
						},
						"session_id": {
							"pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
							"type": "string",
							"x-brand": {
								"__brand": "opaque-id"
							}
						}
					},
					"required": [
						"kind",
						"repository_id",
						"session_id"
					],
					"type": "object"
				},
				"version": {
					"minimum": 0,
					"type": "integer"
				}
			},
			"required": [
				"key",
				"version"
			],
			"type": "object"
		},
		"overlay": {
			"items": {
				"anyOf": [
					{
						"additionalProperties": false,
						"properties": {
							"blob_digest": {
								"pattern": "^[0-9a-f]{64}$",
								"type": "string",
								"x-brand": {
									"__digest": "blob"
								}
							},
							"bytes": {
								"minimum": 0,
								"type": "integer"
							},
							"mode": {
								"enum": [
									"100644",
									"100755"
								],
								"type": "string"
							},
							"path": {
								"type": "string",
								"x-brand": {
									"__brand": "canonical-path"
								}
							},
							"tag": {
								"const": "W"
							}
						},
						"required": [
							"blob_digest",
							"bytes",
							"mode",
							"path",
							"tag"
						],
						"type": "object"
					},
					{
						"additionalProperties": false,
						"properties": {
							"path": {
								"type": "string",
								"x-brand": {
									"__brand": "canonical-path"
								}
							},
							"tag": {
								"const": "D"
							}
						},
						"required": [
							"path",
							"tag"
						],
						"type": "object"
					}
				]
			},
			"type": "array"
		},
		"overlay_manifest": {
			"additionalProperties": false,
			"properties": {
				"deny_ruleset_id": {
					"const": "shadow-overlay-deny-v1"
				},
				"include_rules": {
					"items": {
						"anyOf": [
							{
								"additionalProperties": false,
								"properties": {
									"kind": {
										"const": "exact"
									},
									"path": {
										"type": "string",
										"x-brand": {
											"__brand": "canonical-path"
										}
									}
								},
								"required": [
									"kind",
									"path"
								],
								"type": "object"
							},
							{
								"additionalProperties": false,
								"properties": {
									"kind": {
										"const": "gitwildmatch-v1"
									},
									"pattern": {
										"type": "string"
									}
								},
								"required": [
									"kind",
									"pattern"
								],
								"type": "object"
							}
						]
					},
					"type": "array"
				},
				"schema_version": {
					"const": 1
				}
			},
			"required": [
				"deny_ruleset_id",
				"include_rules",
				"schema_version"
			],
			"type": "object"
		},
		"post_images": {
			"items": {
				"anyOf": [
					{
						"additionalProperties": false,
						"properties": {
							"blob_digest": {
								"pattern": "^[0-9a-f]{64}$",
								"type": "string",
								"x-brand": {
									"__digest": "blob"
								}
							},
							"bytes": {
								"minimum": 0,
								"type": "integer"
							},
							"mode": {
								"enum": [
									"100644",
									"100755"
								],
								"type": "string"
							},
							"path": {
								"type": "string",
								"x-brand": {
									"__brand": "canonical-path"
								}
							},
							"tag": {
								"const": "W"
							}
						},
						"required": [
							"blob_digest",
							"bytes",
							"mode",
							"path",
							"tag"
						],
						"type": "object"
					},
					{
						"additionalProperties": false,
						"properties": {
							"path": {
								"type": "string",
								"x-brand": {
									"__brand": "canonical-path"
								}
							},
							"tag": {
								"const": "D"
							}
						},
						"required": [
							"path",
							"tag"
						],
						"type": "object"
					}
				]
			},
			"type": "array"
		},
		"schema_version": {
			"const": 1
		}
	},
	"required": [
		"mirror",
		"overlay",
		"overlay_manifest",
		"post_images",
		"schema_version"
	],
	"title": "ExecutionManifestV1",
	"type": "object",
	"x-shadow-contract": "structural-shape",
	"x-shadow-contract-meaning": "Shape metadata derived from the TypeScript declarations only (keys, required sets, literals, brand patterns, integers). NOT the validator: byte/array bounds, calendar validity, path rules, set/sort semantics and cross-field rules live in the parsers. A second implementation must port field-checks.ts and the parse-*.ts modules and execute protocol/shadow-v1/fixtures/malformed-corpus.json; schema validity is necessary, not sufficient.",
	"x-shadow-record": {
		"id": "execution_manifest",
		"kind": "wire",
		"module": "types-core.ts",
		"type": "ExecutionManifestV1"
	}
}
